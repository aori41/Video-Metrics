# Port for the local server. If you change it, update VITE_API_BASE_URL in frontend/.env.
PORT=5000

# Replace USER and PASSWORD with your Postgres login.
# Symbols in the password must be URL-encoded, for example @ becomes %40.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/video_metrics

# Only for the tests, which erase this database. Its name must end in _test.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/video_metrics_test

CORS_ALLOWED_ORIGINS=http://localhost:5173

MAX_BATCH_SIZE=120
MAX_SESSION_SECONDS=86400
LATE_SAMPLE_GRACE_SECONDS=120
MAX_REQUEST_BYTES=262144

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_PER_WINDOW=10
RATE_LIMIT_REQUESTS_PER_WINDOW=120

TRUSTED_PROXY_HOPS=0

LOG_LEVEL=INFO
