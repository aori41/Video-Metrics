# Backend URL. Replace 5000 if PORT in backend/.env is different.
VITE_API_BASE_URL=http://localhost:5000

VITE_FPS_MIN=15
VITE_BRIGHTNESS_MIN=60
VITE_BRIGHTNESS_MAX=200
VITE_MOTION_MAX=20

VITE_ANALYSIS_WIDTH=160
VITE_ANALYSIS_HEIGHT=120
VITE_FACE_DETECT_HZ=10
VITE_FACE_MIN_CONFIDENCE=0.5

# VITE_BATCH_SIZE must not exceed the backend's MAX_BATCH_SIZE.
VITE_BATCH_INTERVAL_MS=2000
VITE_BATCH_SIZE=120
VITE_REQUEST_TIMEOUT_MS=10000

VITE_MAX_PAUSE_SECONDS=300
VITE_CHART_WINDOW_SECONDS=30
